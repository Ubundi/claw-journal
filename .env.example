# -----------------------------------------------------------------------------
# Claw Journal full environment template
# Copy to .env and edit values as needed.
#
# Local-only defaults are selected here.
# To expose publicly, set CJ_HOST=0.0.0.0 (see "Public exposure" section).
# -----------------------------------------------------------------------------

# Server binding
CJ_HOST=127.0.0.1
CJ_PORT=3000
CJ_AUTO_PORT=true
CJ_PORT_SEARCH_LIMIT=50

# Frontend dev server port (used by scripts/start-dashboard.sh)
CJ_FRONTEND_PORT=5173

# Runtime logs (persistent by default)
CJ_LOG_DIR=./data/logs
CJ_BACKEND_LOG_FILE=./data/logs/claw-journal-backend.log
CJ_FRONTEND_LOG_FILE=./data/logs/claw-journal-frontend.log

# OpenClaw log ingest (local or mounted remote path)
CJ_OPENCLAW_LOG_GLOB=/tmp/openclaw/openclaw-*.log
CJ_POLL_SECONDS=1.0
# Background durable log sync cadence in seconds (used by install-openclaw-log-sync-launchd.sh)
CJ_LOG_SYNC_INTERVAL=120

# Remote mode + gateway ingest
# Keep CJ_REMOTE_INGEST_MODE=file unless you explicitly use gateway RPC metadata.
CJ_REMOTE_ENABLED=false
CJ_ENSURE_DURABLE_LOGS=false
CJ_REMOTE_INGEST_MODE=file
CJ_REMOTE_GATEWAY_URL=
CJ_REMOTE_GATEWAY_TOKEN=
CJ_REMOTE_GATEWAY_AGENT_ID=

# Remote session sync over SSH (read-only)
# For remote OpenClaw usage, set CJ_REMOTE_ENABLED=true and CJ_REMOTE_SSH_HOST=user@host.
CJ_REMOTE_SSH_HOST=
CJ_REMOTE_OPENCLAW_BIN=/opt/homebrew/bin/openclaw
CJ_REMOTE_PATH_PREFIX=/opt/homebrew/bin
CJ_SESSION_SYNC_ENABLED=true
CJ_SESSION_SYNC_SECONDS=30

# Transcript sync (powers /chat history)
CJ_TRANSCRIPT_SYNC_ENABLED=true
CJ_TRANSCRIPT_SYNC_SECONDS=45
CJ_TRANSCRIPT_GLOB=~/.openclaw/agents/*/sessions/*.jsonl
CJ_REMOTE_TRANSCRIPT_GLOB=~/.openclaw/agents/*/sessions/*.jsonl

# Session transcript ingest (conversation logs, thinking, tool tracking)
# This is the reasoning-branch ingest loop; uses same CJ_TRANSCRIPT_GLOB above.
CJ_TRANSCRIPT_INGEST_ENABLED=true
CJ_TRANSCRIPT_POLL_SECONDS=5.0

# Snapshot backfill (fills historical gaps)
CJ_SNAPSHOT_BACKFILL_ENABLED=true
CJ_SNAPSHOT_BACKFILL_SECONDS=10

# Persistence
CJ_DB_PATH=./data/claw_journal.db

# Cost estimation + pricing catalog
CJ_COST_ESTIMATION_ENABLED=true
CJ_PRICING_FILE=./pricing.json
CJ_OPENROUTER_SYNC_ENABLED=true
CJ_OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
CJ_OPENROUTER_TIMEOUT_SECONDS=8

# Data safety
CJ_REDACTION_ENABLED=true

# Auth + billing profile
CJ_AUTH_MODE=auto
CJ_BILLING_MODE=token
CJ_CLAUDE_MAX_MONTHLY_USD=200

# Startup diagnostics
CJ_STARTUP_HEALTHCHECK_ENABLED=true
CJ_STARTUP_HEALTHCHECK_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Public exposure profile (uncomment/change when intentionally publishing service)
# -----------------------------------------------------------------------------
# CJ_HOST=0.0.0.0
# CJ_AUTO_PORT=false
# CJ_PORT=3000
#
# If exposing to the internet, put Claw Journal behind a reverse proxy with TLS
# and restrict inbound access (allowlist, auth, firewall).
