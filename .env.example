# Server
CJ_HOST=127.0.0.1
CJ_PORT=3000

# OpenClaw log ingest (local or mounted remote path)
CJ_OPENCLAW_LOG_GLOB=/tmp/openclaw/openclaw-*.log
CJ_POLL_SECONDS=1.0

# Remote gateway integration
CJ_REMOTE_ENABLED=false
CJ_REMOTE_GATEWAY_URL=
CJ_REMOTE_GATEWAY_TOKEN=
CJ_REMOTE_GATEWAY_AGENT_ID=
CJ_REMOTE_INGEST_MODE=file

# Read-only remote session truth sync over SSH (recommended for remote OpenClaw)
CJ_REMOTE_SSH_HOST=
CJ_REMOTE_OPENCLAW_BIN=/opt/homebrew/bin/openclaw
CJ_REMOTE_PATH_PREFIX=/opt/homebrew/bin
CJ_SESSION_SYNC_ENABLED=true
CJ_SESSION_SYNC_SECONDS=30

# Persistence
CJ_DB_PATH=./data/claw_journal.db

# Cost estimation fallback
CJ_COST_ESTIMATION_ENABLED=true
CJ_PRICING_FILE=./pricing.json

# Mode configuration
CJ_AUTH_MODE=auto
CJ_BILLING_MODE=token
CJ_CLAUDE_MAX_MONTHLY_USD=200

# Redaction guardrails for persisted raw logs
CJ_REDACTION_ENABLED=true
